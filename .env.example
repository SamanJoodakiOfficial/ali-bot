# NEVER paste secrets in chats. Revoke any previously exposed tokens.
TELEGRAM_BOT_TOKEN=PUT_NEW_TELEGRAM_TOKEN_HERE
OWNER_TELEGRAM_IDS=PUT_YOUR_NUMERIC_ID_HERE
# URL must end at the web base path, not /panel and not /panel/api.
PANEL_URL=https://panel.example.com:2053/secret-path/
PANEL_API_TOKEN=PUT_NEW_3X_UI_ADMIN_TOKEN_HERE
DISPLAY_TIMEZONE=Asia/Tehran
PANEL_TIMEOUT_MS=20000
DB_PATH=/app/data/bot.sqlite
# Defaults to official Telegram API. Optional trusted self-hosted gateway base URL.
TELEGRAM_API_BASE_URL=https://api.telegram.org/
# LEAVE EMPTY unless you have a REAL WORKING HTTP(S) CONNECT proxy!
TELEGRAM_PROXY_URL=
# Default 5s reduces long-poll connection drops. Set 0 to force short polling.
# Range 0..25 seconds; if network repeatedly drops, bot automatically uses 0.
TELEGRAM_POLL_TIMEOUT_SECONDS=5
# Optional public subscription endpoint ending in /sub/ (only if known from panel).
# Never guess a subscription URL; omit to show only subId.
SUBSCRIPTION_BASE_URL=
# If true, attempt to reset used traffic AFTER verified renewal.
RESET_TRAFFIC_ON_RENEW=true
